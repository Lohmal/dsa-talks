# Copy to .env and fill in. On Vercel, add the same keys under Settings → Environment Variables.

# MongoDB connection string; the path segment is the database name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dsatalks?retryWrites=true&w=majority"

# Auth.js — generate with: npx auth secret   (or any 32+ random bytes, base64)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Certificate e-mails (Nodemailer). docker-compose starts Mailpit on localhost:1025 / :8025 for testing.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DSATalks <confdsa@atu.edu.tr>"

# Public address of the site (sitemap, links in e-mails, QR code). Optional on Vercel.
# NEXT_PUBLIC_SITE_URL="https://dsatalks.example.com"
