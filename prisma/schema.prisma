// MongoDB via Prisma 6 (Prisma 7 does not support MongoDB yet).
// Indexes are created with `npm run db:push` (npx prisma db push).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SurveyMode {
  EVENT // one survey per e-mail while the form is open
  SESSION // one survey per e-mail in each speaker time window
}

enum QuestionType {
  RATING // 5 = strongly agree … 1 = strongly disagree
  TEXT
  CHOICE // pick any number of options, optionally plus a free-text "other"
}

enum Template {
  CONFERENCE // the CONFDSA site: the home page and its pages
  EVENT // the one-page event template (DSATalks)
}

// One talk in a speaker time window.
type Talk {
  speaker String
  titleTr String
  titleEn String
}

type ChoiceOption {
  tr String
  en String
}

// One-time link for setting a new admin password ("Şifremi unuttum"). Only a hash of the
// token is stored; links expire after an hour.
model PasswordToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Second step of signing in: a 6-digit code e-mailed after the password. The browser keeps a
// random ticket for this sign-in; only hashes of the ticket and the code are stored. Codes
// expire after 10 minutes.
model LoginCode {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  ticketHash String    @unique
  codeHash   String
  attempts   Int       @default(0) // wrong codes since the last one was sent
  sends      Int       @default(1) // codes sent for this ticket
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A series that comes back every year: CONFDSA (the home page) or an event such as DSATalks
// (/etkinlikler/<slug>). The single "Settings" document of the first version became the
// survey fields of DSATalks 2026 (src/lib/bootstrap.ts).
model Event {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  slug              String   @unique // address: /etkinlikler/<slug>; "confdsa" for the conference
  name              String
  template          Template
  certificatePrefix String // certificate numbers: <prefix>-<year>-XXXXXX
  currentYear       Int // the year shown at the address of the event
  order             Int      @default(0)
  createdAt         DateTime @default(now())
}

// One year of an event with its own texts, survey, questions, responses and certificates.
// Opening a new year copies what is chosen from the previous one; earlier years stay as they were.
model Edition {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  eventId         String     @db.ObjectId
  year            Int
  content         Json? // texts, details, speakers, committees saved in the panel (over the code defaults)
  // Survey
  isOpen          Boolean    @default(false)
  mode            SurveyMode @default(EVENT)
  eventName       String // also printed on the certificate
  speakersText    String // shown as the speaker in EVENT mode
  eventDateTr     String
  eventDateEn     String
  venueTr         String
  venueEn         String
  certificateDate String // date line on EVENT mode certificates, e.g. "4–5 November 2026"
  certificateLogo String? // second logo on the certificate (an image address); empty: the event default
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([eventId, year])
}

// A time window for SESSION mode with one or more talks. Times are stored in UTC and entered
// in Türkiye time. One response (one certificate) per e-mail per window.
model SurveySession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  editionId String   @db.ObjectId
  talks     Talk[]
  // Windows created before talks existed kept a single speaker in these fields.
  speaker   String?
  titleTr   String?
  titleEn   String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([editionId, startsAt])
}

model Question {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  editionId  String         @db.ObjectId
  order      Int
  type       QuestionType
  textTr     String
  textEn     String
  required   Boolean        @default(true)
  options    ChoiceOption[] // CHOICE only
  allowOther Boolean        @default(false) // CHOICE only: adds a free-text "other" field
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([editionId, order])
}

// Answers keep a copy of the question text, so editing or deleting a question later
// never changes what a participant actually answered.
type Answer {
  questionId String
  type       QuestionType
  textTr     String
  textEn     String
  rating     Int?
  text       String? // TEXT answer, or the "other" field of a CHOICE question
  choices    ChoiceOption[] // CHOICE: the options that were ticked
}

model Response {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  editionId        String     @db.ObjectId
  name             String
  email            String
  // "event" in EVENT mode, "session:<id>" in SESSION mode; one response per e-mail per scope
  // and year.
  scope            String
  mode             SurveyMode
  sessionId        String?    @db.ObjectId
  talks            Talk[] // the talks of the window, as they were when the survey was sent
  // Single-talk copies kept by responses saved before talks existed.
  speaker          String?
  talkTitleTr      String?
  talkTitleEn      String?
  sessionStartsAt  DateTime?
  sessionEndsAt    DateTime?
  answers          Answer[]
  locale           String
  certificateNo    String     @unique
  certificateToken String     @unique
  certificateDate  String // date line printed on the certificate
  emailStatus      String     @default("pending") // pending | sending | sent | failed (queue: src/lib/mailQueue.ts)
  emailAttempts    Int?
  emailNextAt      DateTime? // a pending mail is not sent before this time (retry back-off)
  emailError       String?
  emailSentAt      DateTime?
  createdAt        DateTime   @default(now())

  @@unique([editionId, email, scope])
  @@index([editionId, createdAt])
  @@index([sessionId])
  @@index([emailStatus])
}

// A file uploaded in the admin panel (photo, logo, poster PDF), served at /media/<id>. Kept in
// the database so a database backup holds everything.
model Asset {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}
