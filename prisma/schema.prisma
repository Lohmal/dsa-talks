// MongoDB Atlas via Prisma 6 (Prisma 7 does not support MongoDB yet).
// Indexes are created with `npm run db:push`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SurveyMode {
  EVENT // one survey per e-mail while the form is open
  SESSION // one survey per e-mail in each speaker time window
}

enum QuestionType {
  RATING // 5 = strongly agree … 1 = strongly disagree
  TEXT
  CHOICE // pick any number of options, optionally plus a free-text "other"
}

// One talk in a speaker time window.
type Talk {
  speaker String
  titleTr String
  titleEn String
}

type ChoiceOption {
  tr String
  en String
}

// One-time link for setting a new admin password ("Şifremi unuttum"). Only a hash of the
// token is stored; links expire after an hour.
model PasswordToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A single document (key "main") with the survey switch, the mode and the event details.
model Settings {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  key             String     @unique @default("main")
  isOpen          Boolean    @default(false)
  mode            SurveyMode @default(EVENT)
  eventName       String
  speakersText    String // shown as the speaker in EVENT mode
  eventDateTr     String
  eventDateEn     String
  venueTr         String
  venueEn         String
  certificateDate String // date line on EVENT mode certificates, e.g. "4–5 November 2026"
  updatedAt       DateTime   @updatedAt
}

// A time window for SESSION mode with one or more talks. Times are stored in UTC and entered
// in Türkiye time. One response (one certificate) per e-mail per window.
model SurveySession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  talks     Talk[]
  // Windows created before talks existed kept a single speaker in these fields.
  speaker   String?
  titleTr   String?
  titleEn   String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([startsAt])
}

model Question {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  order      Int
  type       QuestionType
  textTr     String
  textEn     String
  required   Boolean        @default(true)
  options    ChoiceOption[] // CHOICE only
  allowOther Boolean        @default(false) // CHOICE only: adds a free-text "other" field
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// Answers keep a copy of the question text, so editing or deleting a question later
// never changes what a participant actually answered.
type Answer {
  questionId String
  type       QuestionType
  textTr     String
  textEn     String
  rating     Int?
  text       String? // TEXT answer, or the "other" field of a CHOICE question
  choices    ChoiceOption[] // CHOICE: the options that were ticked
}

model Response {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String
  // "event" in EVENT mode, "session:<id>" in SESSION mode; one response per e-mail per scope.
  scope            String
  mode             SurveyMode
  sessionId        String?    @db.ObjectId
  talks            Talk[] // the talks of the window, as they were when the survey was sent
  // Single-talk copies kept by responses saved before talks existed.
  speaker          String?
  talkTitleTr      String?
  talkTitleEn      String?
  sessionStartsAt  DateTime?
  sessionEndsAt    DateTime?
  answers          Answer[]
  locale           String
  certificateNo    String     @unique
  certificateToken String     @unique
  certificateDate  String // date line printed on the certificate
  emailStatus      String     @default("pending") // pending | sent | failed
  emailError       String?
  emailSentAt      DateTime?
  createdAt        DateTime   @default(now())

  @@unique([email, scope])
  @@index([createdAt])
  @@index([sessionId])
}
